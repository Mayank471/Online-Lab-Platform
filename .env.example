# MongoDB connection string (MongoDB Atlas for a hosted deployment)
MONGO_URI=

# Secret used to sign the JWT stored in the auth cookie
JWT_SECRET=

# JDoodle code execution credentials
Jdoodle_clientID=
Jdoodle_clientSecret=
JDoodle_API_URL=https://api.jdoodle.com/v1/execute

# Local API port (ignored on Vercel)
PORT=5000

# Comma separated browser origins allowed to call the API with credentials.
# Only needed when the client is served from a different domain than the API.
CLIENT_URL=http://localhost:5173
